# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
# Database (roles and grants: ADR-0002). Dev passwords protect local synthetic data
# only and are not secrets; `pnpm db:setup` creates these roles. Tests use the same URLs with
# the database name replaced by their Vitest worker's clone of transfer_test (transfer_test_<n>).
# Runtime role: only the table grants written in migrations.
DATABASE_URL=postgres://transfer_app:transfer_app_dev@localhost:5432/transfer
# Owner role: migrations and seed.
DATABASE_MIGRATION_URL=postgres://transfer_owner:transfer_owner_dev@localhost:5432/transfer
# `pnpm db:setup` only. Empty in cloud sessions (uses `su postgres`); CI: the service superuser.
DATABASE_ADMIN_URL=
# API (apps/api). Staff auth: dev (the user switcher, never in production) or oidc (Entra ID).
# Both start server-side sessions (cookie __Host-tp_staff; tp_staff over http in development).
AUTH_MODE=dev
# Derives (HKDF) the keys of the OIDC flow cookie and of the import: the saved column mappings'
# header hashes and the preview tokens. Rotating it unlinks saved mappings (only suggestions are
# lost) and invalidates open import previews and logins in progress, never sessions. At least 32 characters; required outside
# development. Empty in development: a random secret per start.
SESSION_SECRET=
# Separate HKDF root for activation codes, private delivery-address hashes and portal one-time
# codes. At least 32 characters and required outside development; from the cluster secret store.
# Rotating it voids open codes and one-time codes, never sessions.
ACCESS_CODE_SECRET=
# HKDF root (`field-encryption:v1`) of the key that encrypts the highly confidential and
# special-category self-service fields in the database (ADR-0002, field encryption). At least 32
# characters and required outside development; from the cluster secret store, never in a file.
# Empty in development: a fixed development constant. Changing it makes stored values unreadable
# (refused as `key_unknown`) until a re-encryption migration exists.
FIELD_ENCRYPTION_KEY=
# HKDF root (`document-encryption:v1`) of the key that wraps each document file's own data key
# (ADR-0006, document files). A root of its own: the object store and its backups are another
# trust domain than the database. At least 32 characters and required outside development; from
# the cluster secret store, never in a file. Empty in development: a fixed development constant.
# Changing it makes stored files unreadable (`key_unknown`) until a re-wrapping migration exists.
DOCUMENT_ENCRYPTION_KEY=
# Public participant portal root (https outside development), with a trailing slash.
PORTAL_PUBLIC_URL=http://localhost:5174/portal/
# CSRF origin allowlist (comma-separated): the web and portal dev servers, and `pnpm start`
# (the built API serving both SPAs on API_PORT).
APP_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001
# Listen port in dev; the image sets PORT=8080, which wins.
API_PORT=3001
# pino level: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# Background jobs (ADR-0011): pg-boss in the API process, as the runtime role on the schema
# `pnpm db:migrate` installs. Tests set false and start it themselves.
JOBS_ENABLED=true
# The nightly lifecycle run, Europe/Berlin local time HH:MM. 02:00–02:59 is refused (DST).
JOBS_LIFECYCLE_TIME=04:15
# The clock (ADR-0006): system, or fixed:<ISO instant> (dev/tests only; refused in production).
CLOCK=system
# Configuration files (ADR-0004): a directory with templates/ (the Agentur templates and
# their manifest) and base-defaults.json, as `pnpm build` copies them to apps/api/dist/config.
# Leave unset in dev and tests (the repo paths); `pnpm start`, Playwright and the image set it.
# CONFIG_DIR=
# Where the Vite dev and preview servers proxy /api to (default http://localhost:3001).
# API_URL=
# Adapters: mock | <provider>
# PDF (ADR-0006): official forms are always filled in process (pdf-lib); our HTML documents (the
# Anlage zum Profilingbogen) go to Gotenberg with `gotenberg`, or are drawn as plain text by the
# mock, which is never wired with NODE_ENV=production (HTML then answers 503 pdf_unavailable).
PDF_ADAPTER=mock
MAIL_ADAPTER=mock
SMS_ADAPTER=mock
# Document files (ADR-0006): filesystem (development, e2e) or memory (tests); `mock` reads as
# filesystem. Neither storage nor the mock scanner is wired with NODE_ENV=production: uploads
# answer 503 there until an S3-compatible store and a ClamAV scanner exist (Q149).
STORAGE_ADAPTER=filesystem
# The filesystem store's directory, outside the web root; unset: .data/documents in the repo
# (git-ignored).
# STORAGE_DIR=
VIRUS_SCAN_ADAPTER=mock
EXPORT_ADAPTER=csv
# No AI in the MVP (ADR-0006)
AI_ADAPTER=none
# Gotenberg (HTML→PDF, a cluster-internal service), required with PDF_ADAPTER=gotenberg, e.g.
# http://localhost:3000. Set, it also runs the adapter's Gotenberg contract test (CI's service
# container); empty, that test is skipped.
GOTENBERG_URL=
# Playwright: browser binary to launch instead of the bundled one. Cloud sessions get it from
# scripts/session-start.sh (spike S2). Leave unset locally and in CI.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Tests: the work list's timing budgets (architecture/overview.md, performance approach) only warn
# by default and fail above a generous ceiling; "strict" also fails them at the budget. Unset in CI.
# PERF_BUDGET=strict
# Staff login with AUTH_MODE=oidc (Entra ID, ADR-0007). All four are required in that mode, or the
# API refuses to start; AUTH_MODE=dev ignores them. Leave empty locally.
# The tenant-specific issuer, e.g. https://login.microsoftonline.com/<tenant-id>/v2.0 (https
# outside development); discovery runs at the first login.
OIDC_ISSUER=
# The app registration's client id.
OIDC_CLIENT_ID=
# The client secret (client_secret_post): from the cluster's secret store or your own local .env,
# never in this file or the repo.
OIDC_CLIENT_SECRET=
# <origin in APP_ORIGINS>/api/v1/auth/callback, registered as the app's redirect URI (https outside
# development), e.g. http://localhost:5173/api/v1/auth/callback in dev.
OIDC_REDIRECT_URL=
