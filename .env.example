# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
DATABASE_URL=postgres://postgres@localhost:5432/transfer
# Adapters: mock | <provider>
PDF_ADAPTER=mock
MAIL_ADAPTER=mock
SMS_ADAPTER=mock
STORAGE_ADAPTER=mock
VIRUS_SCAN_ADAPTER=mock
EXPORT_ADAPTER=csv
# No AI in the MVP (ADR-0006)
AI_ADAPTER=none
# Gotenberg (HTML→PDF), used when PDF_ADAPTER is not mock
GOTENBERG_URL=http://localhost:3000
# Staff login (OIDC, Entra ID). Leave empty locally to use the dev stub login.
OIDC_ISSUER=
OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET goes into a local .env / cluster secret, never into this file
