{
  "name": "transfer-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings --ignore-pattern 'apps/portal/lint-fixtures/**' && oxfmt --check && node scripts/check-tsconfig.mjs",
    "format": "oxfmt",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:setup": "pnpm --filter @transfer/db run setup",
    "db:generate": "pnpm --filter @transfer/db run generate",
    "db:migrate": "pnpm --filter @transfer/db run migrate",
    "db:seed": "pnpm --filter @transfer/db run seed",
    "db:reset": "pnpm --filter @transfer/db run reset",
    "dev": "pnpm db:migrate && pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @transfer/api start",
    "api:generate": "pnpm --filter @transfer/api-client run generate",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm api:generate && git diff --exit-code -- packages/api-client/openapi.json packages/api-client/src/schema.d.ts",
    "test:e2e": "pnpm --filter @transfer/web test:e2e"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "openapi-typescript>typescript": "6"
      }
    }
  }
}
