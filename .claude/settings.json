{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm dev)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm exec *)",
      "Bash(npx playwright *)",
      "Bash(service postgresql start)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/real-data/**)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat * .env*)",
      "Bash(less .env*)",
      "Bash(less ./.env*)",
      "Bash(less * .env*)",
      "Bash(head .env*)",
      "Bash(head ./.env*)",
      "Bash(head * .env*)",
      "Bash(tail .env*)",
      "Bash(tail ./.env*)",
      "Bash(tail * .env*)",
      "Bash(grep * .env*)",
      "Bash(grep * ./.env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf /*)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh"
          }
        ]
      }
    ]
  }
}
