{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm dev)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm start)",
      "Bash(pnpm api:generate)",
      "Bash(pnpm verify)",
      "Bash(pnpm format)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:reset)",
      "Bash(pnpm db:setup)",
      "Bash(pnpm jobs:lifecycle)",
      "Bash(pnpm jobs:lifecycle *)",
      "Bash(pnpm exec *)",
      "Bash(npx playwright *)",
      "Bash(service postgresql start)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(docker *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(less .env)",
      "Bash(less ./.env)",
      "Bash(head .env)",
      "Bash(head ./.env)",
      "Bash(tail .env)",
      "Bash(tail ./.env)",
      "Bash(grep * .env)",
      "Bash(grep * ./.env)",
      "Bash(cat .env.local)",
      "Bash(cat ./.env.local)",
      "Bash(less .env.local)",
      "Bash(less ./.env.local)",
      "Bash(head .env.local)",
      "Bash(head ./.env.local)",
      "Bash(tail .env.local)",
      "Bash(tail ./.env.local)",
      "Bash(grep * .env.local)",
      "Bash(grep * ./.env.local)",
      "Bash(cat .env.*.local)",
      "Bash(cat ./.env.*.local)",
      "Bash(less .env.*.local)",
      "Bash(less ./.env.*.local)",
      "Bash(head .env.*.local)",
      "Bash(head ./.env.*.local)",
      "Bash(tail .env.*.local)",
      "Bash(tail ./.env.*.local)",
      "Bash(grep * .env.*.local)",
      "Bash(grep * ./.env.*.local)",
      "Bash(cat .env.production)",
      "Bash(cat ./.env.production)",
      "Bash(less .env.production)",
      "Bash(less ./.env.production)",
      "Bash(head .env.production)",
      "Bash(head ./.env.production)",
      "Bash(tail .env.production)",
      "Bash(tail ./.env.production)",
      "Bash(grep * .env.production)",
      "Bash(grep * ./.env.production)",
      "Bash(cat .env.development)",
      "Bash(cat ./.env.development)",
      "Bash(less .env.development)",
      "Bash(less ./.env.development)",
      "Bash(head .env.development)",
      "Bash(head ./.env.development)",
      "Bash(tail .env.development)",
      "Bash(tail ./.env.development)",
      "Bash(grep * .env.development)",
      "Bash(grep * ./.env.development)",
      "Bash(cat .env.test)",
      "Bash(cat ./.env.test)",
      "Bash(less .env.test)",
      "Bash(less ./.env.test)",
      "Bash(head .env.test)",
      "Bash(head ./.env.test)",
      "Bash(tail .env.test)",
      "Bash(tail ./.env.test)",
      "Bash(grep * .env.test)",
      "Bash(grep * ./.env.test)",
      "Read(./**/real-data/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf /*)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh"
          }
        ]
      }
    ]
  }
}
