{
  "openapi": "3.1.0",
  "info": {
    "title": "Transfer Platform API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pointer": {
                  "type": "string",
                  "description": "JSON pointer into the body"
                },
                "parameter": {
                  "type": "string",
                  "description": "Query or path parameter"
                },
                "code": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "detail"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ]
      },
      "StaffUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          }
        },
        "required": [
          "id",
          "displayName",
          "role"
        ]
      },
      "StaffRole": {
        "type": "string",
        "enum": [
          "admin",
          "regional_admin",
          "project_lead",
          "consultant",
          "back_office",
          "regional_operations_manager"
        ]
      },
      "ProjectPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ProjectType"
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          },
          "projectAgenturKey": {
            "type": [
              "string",
              "null"
            ],
            "description": "The Project Agentur (the KuG-Agentur for ta_tg, Q90)"
          },
          "activatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "UTC timestamp (ISO 8601)"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp (ISO 8601)"
          },
          "createdBy": {
            "type": "string",
            "format": "uuid",
            "description": "Staff user id"
          }
        },
        "required": [
          "id",
          "name",
          "customerName",
          "type",
          "status",
          "projectAgenturKey",
          "activatedAt",
          "createdAt",
          "createdBy"
        ]
      },
      "ProjectType": {
        "type": "string",
        "enum": [
          "ta_only",
          "ta_tg"
        ],
        "description": "ta_only: Transferagentur only. ta_tg: Transferagentur and Transfergesellschaft."
      },
      "ProjectStatus": {
        "type": "string",
        "enum": [
          "draft",
          "active"
        ],
        "description": "draft: setup only, no lifecycle transitions. active: activated (one-way)."
      },
      "CreateProjectInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "customerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "$ref": "#/components/schemas/ProjectType"
          }
        },
        "required": [
          "name",
          "customerName",
          "type"
        ],
        "additionalProperties": false
      },
      "UpdateProjectInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "customerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "$ref": "#/components/schemas/ProjectType"
          }
        },
        "additionalProperties": false
      },
      "EntryWavePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntryWave"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "EntryWave": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "signingDeadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          },
          "defaultTgStart": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          },
          "defaultTgEnd": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          },
          "latestEntryDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          },
          "participations": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp (ISO 8601)"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp (ISO 8601)"
          }
        },
        "required": [
          "id",
          "projectId",
          "code",
          "name",
          "signingDeadline",
          "defaultTgStart",
          "defaultTgEnd",
          "latestEntryDate",
          "participations",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateEntryWaveInput": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "signingDeadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          },
          "defaultTgStart": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          },
          "defaultTgEnd": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          },
          "latestEntryDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          }
        },
        "required": [
          "code",
          "name"
        ],
        "additionalProperties": false
      },
      "UpdateEntryWaveInput": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "signingDeadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          },
          "defaultTgStart": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          },
          "defaultTgEnd": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          },
          "latestEntryDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "A calendar date in the format YYYY-MM-DD (no time, no time zone).",
            "examples": [
              "2027-03-01"
            ]
          }
        },
        "additionalProperties": false
      },
      "TemplateCatalogPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateCatalogEntry"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "TemplateCatalogEntry": {
        "type": "object",
        "properties": {
          "agenturKey": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "object",
            "properties": {
              "de": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "de"
            ],
            "additionalProperties": false
          },
          "sample": {
            "type": "boolean"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "agenturKey",
          "version",
          "label",
          "sample",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "The API runs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "version"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: the database answers",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "version"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "The current staff user",
        "responses": {
          "200": {
            "description": "The current staff user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffUser"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "The projects the user may see, newest first (cursor pagination)",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Opaque cursor from `nextCursor`."
            },
            "required": false,
            "description": "Opaque cursor from `nextCursor`.",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of projects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectPage"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Create a project; the creator becomes its PL",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{projectId}": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "One project",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "projects"
        ],
        "summary": "Change name, customer or type (the type only while draft and unused, Q98)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProjectInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The changed project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Refused by a domain rule",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/entry-waves": {
      "get": {
        "tags": [
