          "value": "(\"participation\".\"profiling_status\" = 'profiling_done') = (\"profiling_done_on\" is not null)"
        },
        "participation_tracks_start_at_informed": {
          "name": "participation_tracks_start_at_informed",
          "value": "not (\"participation\".\"status\" in ('self_registered', 'rejected', 'imported', 'contacted', 'unreachable')) or (\"participation\".\"profiling_status\" = 'not_started' and \"participation\".\"dsv_status\" = 'not_offered')"
        },
        "participation_tg_needs_signed_dsv": {
