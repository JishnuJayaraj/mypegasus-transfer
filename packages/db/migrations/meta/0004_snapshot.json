          "value": "\"participation\".\"tg_start\" <= \"participation\".\"tg_end\""
        },
        "participation_offer_deadline_before_tg_start": {
          "name": "participation_offer_deadline_before_tg_start",
          "value": "\"participation\".\"offer_deadline\" <= \"participation\".\"tg_start\""
        },
        "participation_offer_needs_wave": {
          "name": "participation_offer_needs_wave",
          "value": "\"participation\".\"dsv_status\" = 'not_offered' or \"participation\".\"entry_wave_id\" is not null"
        },
        "participation_end_reason_when_ended": {
          "name": "participation_end_reason_when_ended",
          "value": "(\"participation\".\"status\" in ('withdrawn', 'exited')) = (\"end_reason\" is not null)"
        },
        "participation_end_reason_source_with_reason": {
