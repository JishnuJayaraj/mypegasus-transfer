      "checkConstraints": {
        "audit_event_actor_consistent": {
          "name": "audit_event_actor_consistent",
          "value": "case \"audit_event\".\"actor_type\"\n        when 'user' then \"audit_event\".\"actor_staff_user_id\" is not null and \"audit_event\".\"actor_participation_id\" is null and \"audit_event\".\"system_job\" is null\n        when 'participant' then \"audit_event\".\"actor_participation_id\" is not null and \"audit_event\".\"actor_staff_user_id\" is null and \"audit_event\".\"system_job\" is null and \"audit_event\".\"on_behalf_of_participation_id\" is null\n        else \"audit_event\".\"system_job\" is not null and \"audit_event\".\"actor_staff_user_id\" is null and \"audit_event\".\"actor_participation_id\" is null and \"audit_event\".\"on_behalf_of_participation_id\" is null\n      end"
        },
        "audit_event_lifecycle_has_participation": {
          "name": "audit_event_lifecycle_has_participation",
          "value": "\"audit_event\".\"participation_id\" is not null or \"audit_event\".\"event_type\" not in ('participation_created', 'status_changed', 'entry_wave_assigned', 'profiling_exception_requested', 'profiling_exception_approved', 'profiling_exception_rejected', 'profiling_exception_revoked', 'profiling_exception_superseded', 'end_reason_corrected', 'sensitive_read', 'sensitive_write', 'break_glass_access', 'document_opened')"
        },
        "audit_event_change_values": {
          "name": "audit_event_change_values",
          "value": "case\n        when \"audit_event\".\"event_type\" = 'status_changed' then \"audit_event\".\"field\" is not null and \"audit_event\".\"from_value\" is not null and \"audit_event\".\"to_value\" is not null\n        when \"audit_event\".\"event_type\" = 'participation_created' then \"audit_event\".\"field\" = 'status' and \"audit_event\".\"from_value\" is null and \"audit_event\".\"to_value\" = 'imported'\n        when \"audit_event\".\"event_type\" = 'end_reason_corrected' then \"audit_event\".\"field\" is null and \"audit_event\".\"from_value\" = any(enum_range(null::end_reason)::text[]) and \"audit_event\".\"to_value\" = any(enum_range(null::end_reason)::text[])\n        else \"audit_event\".\"field\" is null and \"audit_event\".\"from_value\" is null and \"audit_event\".\"to_value\" is null\n      end"
        },
        "audit_event_values_of_field": {
          "name": "audit_event_values_of_field",
          "value": "\"audit_event\".\"field\" is null or case \"audit_event\".\"field\"\n        when 'status' then \"audit_event\".\"to_value\" = any(enum_range(null::main_status)::text[]) and (\"audit_event\".\"from_value\" is null or \"audit_event\".\"from_value\" = any(enum_range(null::main_status)::text[]))\n        when 'profiling_status' then \"audit_event\".\"to_value\" = any(enum_range(null::profiling_status)::text[]) and \"audit_event\".\"from_value\" = any(enum_range(null::profiling_status)::text[])\n        else \"audit_event\".\"to_value\" = any(enum_range(null::dsv_status)::text[]) and \"audit_event\".\"from_value\" = any(enum_range(null::dsv_status)::text[])\n      end"
        },
        "audit_event_reason_code_is_code": {
          "name": "audit_event_reason_code_is_code",
          "value": "\"audit_event\".\"reason_code\" ~ '^[a-z][a-z0-9_]{0,62}$' and \"audit_event\".\"reason_code\" <> 'long_term_illness_reduced_earning_capacity'"
        },
        "audit_event_system_job_is_name": {
          "name": "audit_event_system_job_is_name",
          "value": "\"audit_event\".\"system_job\" ~ '^[a-z][a-z0-9_.-]{0,62}$'"
        },
        "audit_event_request_id_is_id": {
          "name": "audit_event_request_id_is_id",
          "value": "\"audit_event\".\"request_id\" ~ '^[A-Za-z0-9_.:-]{1,64}$'"
        },
        "audit_event_job_id_is_id": {
          "name": "audit_event_job_id_is_id",
          "value": "\"audit_event\".\"job_id\" ~ '^[A-Za-z0-9_.:-]{1,64}$'"
        },
        "audit_event_details_ids_and_codes": {
          "name": "audit_event_details_ids_and_codes",
          "value": "jsonb_typeof(\"audit_event\".\"details\") = 'object' and not jsonb_path_exists(\"audit_event\".\"details\", 'strict $.** ? (@.type() == \"string\" && !(@ like_regex \"^[A-Za-z0-9_.:+-]{1,100}$\"))') and not jsonb_path_exists(\"audit_event\".\"details\", 'strict $.** ? (@.type() == \"object\").keyvalue() ? (!(@.key like_regex \"^[a-z][A-Za-z0-9]{0,62}$\"))')"
        }
      },
      "isRLSEnabled": false
    },
