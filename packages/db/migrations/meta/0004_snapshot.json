          "value": "(end_reason is not null) = (\"end_reason_source\" is not null)"
        },
        "participation_secondary_reasons_with_reason": {
          "name": "participation_secondary_reasons_with_reason",
          "value": "\"participation\".\"end_reason\" is not null or cardinality(\"participation\".\"end_reason_secondary\") = 0"
        },
        "participation_end_reason_storable": {
          "name": "participation_end_reason_storable",
          "value": "\"participation\".\"end_reason\" is distinct from 'long_term_illness_reduced_earning_capacity' and not ('long_term_illness_reduced_earning_capacity' = any(\"participation\".\"end_reason_secondary\"))"
        },
        "participation_withdrawn_on_when_withdrawn": {
          "name": "participation_withdrawn_on_when_withdrawn",
          "value": "(\"participation\".\"status\" in ('withdrawn')) = (\"withdrawn_on\" is not null)"
        },
        "participation_tg_entry_date_in_tg": {
          "name": "participation_tg_entry_date_in_tg",
          "value": "(\"participation\".\"status\" in ('active_in_tg', 'exited')) = (\"tg_entry_date\" is not null)"
        },
