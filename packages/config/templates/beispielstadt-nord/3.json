{
  "$schema": "../../schema/regional-template.schema.json",
  "schemaVersion": 1,
  "kind": "regional_template",
  "id": "beispielstadt-nord",
  "version": 3,
  "agenturKey": "beispielstadt-nord",
  "sample": true,
  "label": {
    "de": "Agentur für Arbeit Beispielstadt Nord (Beispiel)",
    "en": "Employment agency Beispielstadt Nord (sample)"
  },
  "settings": {
    "asu_registration": {
      "defaultChannel": "kug_200b",
      "batchSubmissionChannel": "upload"
    },
    "agentur_submission": {
      "submissionChannel": "upload",
      "originalRequired": false,
      "leadTimeDays": 14,
      "rejectsOutdatedFormVersions": true
    }
  },
  "fields": {
    "custom.beispiel_zusatznachweis_nr": {
      "type": "string",
      "maxLength": 40,
      "x-dataClass": "confidential",
      "x-retentionClass": "participation_record",
      "x-label": {
        "de": "Zusatznachweis-Nr. (Beispiel)",
        "en": "Additional certificate no. (sample)"
      }
    }
  },
  "rules": {
    "data_collection": [
      {
        "id": "beispielstadt-nord-zusatznachweis",
        "kind": "required",
        "field": "custom.beispiel_zusatznachweis_nr",
        "basis": "operational_default"
      },
      {
        "id": "beispielstadt-nord-mobile",
        "kind": "required",
        "field": "mobile",
        "basis": "operational_default"
      }
    ],
    "profiling": [
      {
        "id": "beispielstadt-nord-private-email",
        "kind": "required",
        "field": "privateEmail",
        "basis": "operational_default"
      }
    ]
  },
  "helpTexts": {
    "de": {
      "agentur_submission.intro": "Beispiel: Diese fiktive Agentur nimmt Unterlagen per Upload an.",
      "self_service.custom.beispiel_zusatznachweis_nr": "Beispiel: Die Nummer steht oben rechts auf Ihrem Zusatznachweis.",
      "self_service.privateEmail": "Beispiel: Diese Agentur schreibt Ihnen an Ihre private E-Mail-Adresse."
    },
    "en": {
      "agentur_submission.intro": "Sample: this fictional agency accepts documents by upload.",
      "self_service.custom.beispiel_zusatznachweis_nr": "Sample: the number is at the top right of your additional certificate.",
      "self_service.privateEmail": "Sample: this agency writes to your private email address."
    }
  }
}
